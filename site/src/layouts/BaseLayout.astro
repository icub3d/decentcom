---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Open-source, self-hostable community communication where your identity is a key pair you own." } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | decentcom</title>
		<meta name="description" content={description} />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={`${title} | decentcom`} />
		<meta property="og:description" content={description} />
		
		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={`${title} | decentcom`} />
		<meta property="twitter:description" content={description} />
	</head>
	<body class="min-h-screen flex flex-col bg-ctp-base text-ctp-text selection:bg-ctp-mauve/30 selection:text-ctp-text">
		<header class="sticky top-0 z-50 w-full border-b border-ctp-surface1 bg-ctp-base/80 backdrop-blur">
			<nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
				<div class="flex items-center gap-2">
					<a href={`${base}/`} class="text-xl font-bold tracking-tight text-ctp-text hover:text-ctp-mauve transition-colors">
						decentcom
					</a>
				</div>
				<div class="hidden md:flex md:items-center md:gap-8">
					<a href={`${base}/features`} class="text-sm font-medium text-ctp-subtext1 hover:text-ctp-mauve transition-colors">Features</a>
					<a href={`${base}/download`} class="text-sm font-medium text-ctp-subtext1 hover:text-ctp-mauve transition-colors">Download</a>
					<a href="https://github.com/icub3d/decentcom" class="text-sm font-medium text-ctp-subtext1 hover:text-ctp-mauve transition-colors" target="_blank" rel="noopener noreferrer">GitHub</a>
				</div>
				<div class="md:hidden">
					<!-- Mobile menu button could go here -->
				</div>
			</nav>
		</header>

		<main class="flex-grow">
			<slot />
		</main>

		<footer class="border-t border-ctp-surface1 bg-ctp-mantle">
			<div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
				<div class="grid grid-cols-1 gap-8 md:grid-cols-3">
					<div class="space-y-4">
						<h3 class="text-lg font-bold text-ctp-text">decentcom</h3>
						<p class="text-sm text-ctp-subtext0">
							Open-source community communication you can self-host. 
							Your identity is yours, cryptographically secured.
						</p>
					</div>
					<div>
						<h4 class="text-sm font-semibold uppercase tracking-wider text-ctp-subtext1">Resources</h4>
						<ul class="mt-4 space-y-2">
							<li><a href="https://github.com/icub3d/decentcom" class="text-sm text-ctp-subtext0 hover:text-ctp-mauve transition-colors">GitHub Repository</a></li>
							<li><a href="https://github.com/icub3d/decentcom/tree/main/docs" class="text-sm text-ctp-subtext0 hover:text-ctp-mauve transition-colors">Documentation</a></li>
						</ul>
					</div>
					<div>
						<h4 class="text-sm font-semibold uppercase tracking-wider text-ctp-subtext1">Legal</h4>
						<p class="mt-4 text-sm text-ctp-subtext0">
							MIT Licensed.
						</p>
					</div>
				</div>
				<div class="mt-12 border-t border-ctp-surface1 pt-8 text-center">
					<p class="text-xs text-ctp-subtext0">&copy; {new Date().getFullYear()} decentcom. Built with Astro and Catppuccin.</p>
				</div>
			</div>
		</footer>
	</body>
</html>
